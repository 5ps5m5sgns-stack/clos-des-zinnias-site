# Origines réellement utilisées dans le code (relevé du 05/10/2026) :
#   scripts : 'self' + https://connect.facebook.net (Pixel Meta, uniquement après consentement)
#   requêtes : 'self' + https://formspree.io (formulaire) + https://www.facebook.com (balise Pixel)
#   cadres : https://www.google.com (carte de environnement.html)
#   inline : <style> critique dans chaque page, attributs style="", onload="" sur les <link>
